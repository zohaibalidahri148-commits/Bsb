function calculate1RM(){
  hideValidation();
  var wv = document.getElementById('weightInput').value.trim();
  var rv = document.getElementById('repsInput').value.trim();
  var unit = document.getElementById('unitSelect').value;
  if (wv === '') { showValidation('Please enter the weight you lifted.'); return; }
  var weight = parseFloat(wv);
  if (isNaN(weight) || weight <= 0) { showValidation('Weight must be a positive number.'); return; }
  if (weight > 2000) { showValidation('Please enter a realistic weight value.'); return; }
  if (rv === '') { showValidation('Please enter the number of repetitions.'); return; }
  var reps = parseInt(rv, 10);
  if (isNaN(reps) || reps < 1) { showValidation('Repetitions must be at least 1.'); return; }
  if (reps > 15) { showValidation('For accuracy, please use a set of 15 reps or fewer.'); return; }
  var oneRM = weight * (36 / (37 - reps));
  oneRM = Math.round(oneRM * 10) / 10;
  document.getElementById('resultValue').textContent = oneRM.toFixed(1);
  document.getElementById('resultUnit').textContent = unit;
  var zones = [
    {pct: 60, label: 'Warm-up'},
    {pct: 70, label: 'Endurance'},
    {pct: 80, label: 'Hypertrophy'},
    {pct: 90, label: 'Strength'},
    {pct: 100, label: 'Max'}
  ];
  var html = '';
  zones.forEach(function(z){
    var zw = Math.round(oneRM * z.pct / 100 * 10) / 10;
    html += '<div class="zone-item"><div class="zone-percent">' + z.pct + '%</div><div class="zone-weight">' + zw.toFixed(1) + '</div><div class="zone-label">' + z.label + '</div></div>';
  });
  document.getElementById('zonesGrid').innerHTML = html;
  var wrapper = document.getElementById('resultWrapper');
  wrapper.classList.add('visible');
  var valEl = document.getElementById('resultValue');
  valEl.style.animation = 'none';
  valEl.offsetHeight;
  valEl.style.animation = '';
  setTimeout(function(){ wrapper.scrollIntoView({behavior: 'smooth', block: 'nearest'}); }, 100);
}
function resetCalculator(){
  document.getElementById('weightInput').value = '';
  document.getElementById('repsInput').value = '';
  document.getElementById('unitSelect').value = 'kg';
  hideValidation();
  document.getElementById('resultWrapper').classList.remove('visible');
  document.getElementById('weightInput').focus();
}
document.getElementById('weightInput').addEventListener('keydown', function(e){ if (e.key === 'Enter') calculate1RM(); });
document.getElementById('repsInput').addEventListener('keydown', function(e){ if (e.key === 'Enter') calculate1RM(); });
</script>

